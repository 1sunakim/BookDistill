# Optional Docker build mirrors for restricted networks.
# BOOKDISTILL_BASE_IMAGE=public.ecr.aws/docker/library/python:3.11-slim
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

BOOKDISTILL_DATABASE_URL=postgresql+psycopg://bookdistill:bookdistill@postgres:5432/bookdistill
BOOKDISTILL_REDIS_URL=redis://redis:6379/0
BOOKDISTILL_STORAGE_ROOT=/app/data
BOOKDISTILL_QUEUE_MODE=celery
BOOKDISTILL_HEARTBEAT_TIMEOUT_SECONDS=120
BOOKDISTILL_RETRY_BASE_SECONDS=5
BOOKDISTILL_CHUNK_MAX_TOKENS=512
BOOKDISTILL_CHUNK_OVERLAP_TOKENS=64
BOOKDISTILL_DENSE_BACKEND=qdrant
BOOKDISTILL_QDRANT_URL=http://qdrant:6333
BOOKDISTILL_QDRANT_COLLECTION=bookdistill_chunks
BOOKDISTILL_EMBEDDING_DIMENSION=384
BOOKDISTILL_EMBEDDING_PROVIDER=fastembed
BOOKDISTILL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
BOOKDISTILL_RERANKER_PROVIDER=fastembed
BOOKDISTILL_RERANKER_MODEL=BAAI/bge-reranker-base
BOOKDISTILL_MODEL_CACHE_DIR=/app/model-cache
BOOKDISTILL_LLM_PROVIDER=disabled
BOOKDISTILL_LLM_MODEL=
BOOKDISTILL_LLM_BASE_URL=https://api.openai.com/v1
BOOKDISTILL_LLM_API_KEY=
BOOKDISTILL_LLM_TIMEOUT_SECONDS=60
BOOKDISTILL_LLM_RESPONSE_FORMAT=json_schema
# 本地模型与API二选一；API配置保留不变。
# BOOKDISTILL_LLM_PROVIDER=transformers-local
# BOOKDISTILL_LLM_LOCAL_MODEL_PATH=E:/mymodel/models/Qwen1.5-1.8B
# BOOKDISTILL_LLM_LOCAL_ADAPTER_PATH=E:/mymodel/models/qwen1.8b_lora_local
# BOOKDISTILL_LLM_LOCAL_DEVICE=auto
# BOOKDISTILL_LLM_LOCAL_DTYPE=auto
# BOOKDISTILL_LLM_LOCAL_MAX_INPUT_TOKENS=8192
BOOKDISTILL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://bookdistill-reader.sdsdashsshshshsh.chatgpt.site
