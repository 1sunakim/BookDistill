# Optional Docker build mirrors for restricted networks.
# BOOKDISTILL_BASE_IMAGE=public.ecr.aws/docker/library/python:3.11.9-slim-bookworm
# BOOKDISTILL_NODE_BASE_IMAGE=public.ecr.aws/docker/library/node:22.13.1-bookworm-slim
# BOOKDISTILL_POSTGRES_IMAGE=<reachable-registry>/postgres:17-alpine
# BOOKDISTILL_REDIS_IMAGE=<reachable-registry>/redis:7-alpine
# BOOKDISTILL_QDRANT_IMAGE=<reachable-registry>/qdrant/qdrant:v1.15.4
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_CONFIG_REGISTRY=https://registry.npmmirror.com/

BOOKDISTILL_DATABASE_URL=postgresql+psycopg://bookdistill:bookdistill@postgres:5432/bookdistill
BOOKDISTILL_REDIS_URL=redis://redis:6379/0
BOOKDISTILL_STORAGE_ROOT=/app/data
BOOKDISTILL_IMAGE_MAX_UPLOAD_BYTES=20971520
BOOKDISTILL_IMAGE_MAX_PIXELS=40000000
BOOKDISTILL_IMAGE_MAX_DIMENSION=16384
BOOKDISTILL_QUEUE_MODE=celery
BOOKDISTILL_HEARTBEAT_TIMEOUT_SECONDS=120
BOOKDISTILL_RETRY_BASE_SECONDS=5
BOOKDISTILL_WORKER_CONCURRENCY=2
BOOKDISTILL_WORKER_HEARTBEAT_TTL_SECONDS=45
BOOKDISTILL_CHUNK_MAX_TOKENS=512
BOOKDISTILL_CHUNK_OVERLAP_TOKENS=64
BOOKDISTILL_DENSE_BACKEND=qdrant
BOOKDISTILL_QDRANT_URL=http://qdrant:6333
BOOKDISTILL_QDRANT_COLLECTION=bookdistill_chunks
BOOKDISTILL_EMBEDDING_DIMENSION=384
BOOKDISTILL_EMBEDDING_PROVIDER=hashing
BOOKDISTILL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
BOOKDISTILL_RERANKER_PROVIDER=token_overlap
BOOKDISTILL_RERANKER_MODEL=BAAI/bge-reranker-base
BOOKDISTILL_MODEL_CACHE_DIR=/app/model-cache
BOOKDISTILL_LLM_PROVIDER=demo
BOOKDISTILL_LLM_ADAPTER=legacy
BOOKDISTILL_STRUCTURED_OUTPUT_BACKEND=legacy
# Set to langchain to use the optional LangChain adapter for openai-compatible models.
# Revert to legacy to roll back without changing model profiles or generated data.
BOOKDISTILL_RAG_PIPELINE=legacy
BOOKDISTILL_LLM_MODEL=demo-extractive-v1
BOOKDISTILL_LLM_BASE_URL=https://api.openai.com/v1
BOOKDISTILL_LLM_API_KEY=
BOOKDISTILL_LLM_TIMEOUT_SECONDS=60
BOOKDISTILL_LLM_RESPONSE_FORMAT=json_schema
BOOKDISTILL_LLM_MAX_CONTEXT_TOKENS=8192
BOOKDISTILL_LLM_COST_LIMIT_USD=1.0
BOOKDISTILL_DEFAULT_LANGUAGE=bilingual
BOOKDISTILL_MIN_CLAIM_SUPPORT_OVERLAP=0.05
BOOKDISTILL_MIN_EVIDENCE_RELEVANCE=0.02
# DeepSeek：填入密钥后，用以下五项替换上面的 demo 配置。
# BOOKDISTILL_LLM_PROVIDER=openai-compatible
# BOOKDISTILL_LLM_MODEL=deepseek-flash
# BOOKDISTILL_LLM_BASE_URL=https://api.deepseek.com
# BOOKDISTILL_LLM_API_KEY=sk-...
# BOOKDISTILL_LLM_RESPONSE_FORMAT=json_object
# 能力值：json_schema、json_object、tool_calling、text_parser；必须与模型接口能力一致。
# 切换到 LangChain 调用适配器前，在镜像/环境中安装项目的 langchain 可选依赖组。
# BOOKDISTILL_LLM_ADAPTER=langchain
# 本地模型与API二选一；API配置保留不变。
# BOOKDISTILL_LLM_PROVIDER=transformers-local
# BOOKDISTILL_LLM_LOCAL_MODEL_PATH=E:/mymodel/models/Qwen1.5-1.8B
# BOOKDISTILL_LLM_LOCAL_ADAPTER_PATH=E:/mymodel/models/qwen1.8b_lora_local
# BOOKDISTILL_LLM_LOCAL_DEVICE=auto
# BOOKDISTILL_LLM_LOCAL_DTYPE=auto
# BOOKDISTILL_LLM_LOCAL_MAX_INPUT_TOKENS=8192
BOOKDISTILL_PUBLIC_API_URL=http://127.0.0.1:8000
# 当前保持 127.0.0.1；配置 HTTPS 反向代理和 API key 后才改为 0.0.0.0。
BOOKDISTILL_BIND_ADDRESS=127.0.0.1
BOOKDISTILL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 新增图片和导出接口在本机也要求配置 Key；客户端发送 X-BookDistill-API-Key。
BOOKDISTILL_API_KEY=
BOOKDISTILL_RATE_LIMIT_PER_MINUTE=240
