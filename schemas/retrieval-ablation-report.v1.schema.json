{
  "$defs": {
    "AblationMetricSnapshot": {
      "additionalProperties": false,
      "properties": {
        "recall_at_10": {
          "maximum": 1,
          "minimum": 0,
          "title": "Recall At 10",
          "type": "number"
        },
        "mrr": {
          "maximum": 1,
          "minimum": 0,
          "title": "Mrr",
          "type": "number"
        },
        "ndcg_at_10": {
          "maximum": 1,
          "minimum": 0,
          "title": "Ndcg At 10",
          "type": "number"
        },
        "latency_p50_ms": {
          "minimum": 0,
          "title": "Latency P50 Ms",
          "type": "number"
        },
        "latency_p95_ms": {
          "minimum": 0,
          "title": "Latency P95 Ms",
          "type": "number"
        },
        "missing_or_failed_predictions": {
          "minimum": 0,
          "title": "Missing Or Failed Predictions",
          "type": "integer"
        }
      },
      "required": [
        "recall_at_10",
        "mrr",
        "ndcg_at_10",
        "latency_p50_ms",
        "latency_p95_ms",
        "missing_or_failed_predictions"
      ],
      "title": "AblationMetricSnapshot",
      "type": "object"
    },
    "AblationVariantResult": {
      "additionalProperties": false,
      "properties": {
        "retrieval_variant": {
          "enum": [
            "sparse",
            "dense",
            "hybrid",
            "hybrid_rerank"
          ],
          "title": "Retrieval Variant",
          "type": "string"
        },
        "experiment_id": {
          "title": "Experiment Id",
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/AblationMetricSnapshot"
        },
        "recall_at_10_delta_vs_sparse": {
          "title": "Recall At 10 Delta Vs Sparse",
          "type": "number"
        },
        "mrr_delta_vs_sparse": {
          "title": "Mrr Delta Vs Sparse",
          "type": "number"
        },
        "ndcg_at_10_delta_vs_sparse": {
          "title": "Ndcg At 10 Delta Vs Sparse",
          "type": "number"
        },
        "latency_p95_delta_vs_sparse_ms": {
          "title": "Latency P95 Delta Vs Sparse Ms",
          "type": "number"
        }
      },
      "required": [
        "retrieval_variant",
        "experiment_id",
        "metrics",
        "recall_at_10_delta_vs_sparse",
        "mrr_delta_vs_sparse",
        "ndcg_at_10_delta_vs_sparse",
        "latency_p95_delta_vs_sparse_ms"
      ],
      "title": "AblationVariantResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_name": {
      "title": "Dataset Name",
      "type": "string"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/AblationVariantResult"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Variants",
      "type": "array"
    },
    "best_recall_at_10_variant": {
      "title": "Best Recall At 10 Variant",
      "type": "string"
    },
    "best_ndcg_at_10_variant": {
      "title": "Best Ndcg At 10 Variant",
      "type": "string"
    },
    "fastest_p95_variant": {
      "title": "Fastest P95 Variant",
      "type": "string"
    }
  },
  "required": [
    "dataset_name",
    "dataset_version",
    "created_at",
    "variants",
    "best_recall_at_10_variant",
    "best_ndcg_at_10_variant",
    "fastest_p95_variant"
  ],
  "title": "RetrievalAblationReport",
  "type": "object"
}
