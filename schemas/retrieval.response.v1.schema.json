{
  "$defs": {
    "CandidateTrace": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "format": "uuid",
          "title": "Chunk Id",
          "type": "string"
        },
        "dense_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dense Score"
        },
        "dense_rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dense Rank"
        },
        "sparse_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sparse Score"
        },
        "sparse_rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sparse Rank"
        },
        "fusion_score": {
          "minimum": 0,
          "title": "Fusion Score",
          "type": "number"
        },
        "fusion_rank": {
          "minimum": 1,
          "title": "Fusion Rank",
          "type": "integer"
        },
        "rerank_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank Score"
        },
        "final_rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Rank"
        }
      },
      "required": [
        "chunk_id",
        "fusion_score",
        "fusion_rank"
      ],
      "title": "CandidateTrace",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
