        "context_expanded": {
          "default": false,
          "title": "Context Expanded",
          "type": "boolean"
        },
        "estimated_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Estimated Tokens",
          "type": "integer"
        }
      },
      "required": [
        "evidence_id",
        "chunk_id",
        "book_id",
        "chapter_id",
        "chapter_path",
        "page_start",
        "page_end",
        "text",
        "fusion_score",
        "fusion_rank",
        "final_rank",
        "retrieval_version"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "RetrievalTrace": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "original_query": {
          "title": "Original Query",
          "type": "string"
        },
        "normalized_query": {
          "title": "Normalized Query",
          "type": "string"
        },
        "retrieval_version": {
          "title": "Retrieval Version",
          "type": "string"
        },
        "retrieval_variant": {
          "enum": [
            "sparse",
            "dense",
            "hybrid",
            "hybrid_rerank"
          ],
          "title": "Retrieval Variant",
          "type": "string"
        },
        "indexed_chunk_count": {
          "minimum": 0,
          "title": "Indexed Chunk Count",
          "type": "integer"
        },
        "dense_latency_ms": {
          "minimum": 0,
          "title": "Dense Latency Ms",
          "type": "number"
        },
        "sparse_latency_ms": {
          "minimum": 0,
          "title": "Sparse Latency Ms",
          "type": "number"
        },
        "fusion_latency_ms": {
          "minimum": 0,
          "title": "Fusion Latency Ms",
          "type": "number"
        },
        "rerank_latency_ms": {
          "minimum": 0,
          "title": "Rerank Latency Ms",
          "type": "number"
        },
        "total_latency_ms": {
          "minimum": 0,
          "title": "Total Latency Ms",
          "type": "number"
        },
        "rerank_degraded": {
          "default": false,
          "title": "Rerank Degraded",
          "type": "boolean"
        },
        "rerank_applied": {
          "default": false,
          "title": "Rerank Applied",
          "type": "boolean"
        },
        "dense_status": {
          "default": "skipped",
          "enum": [
            "skipped",
            "hit",
            "empty",
            "timeout",
            "error"
          ],
          "title": "Dense Status",
          "type": "string"
        },
        "sparse_status": {
          "default": "skipped",
          "enum": [
            "skipped",
            "hit",
            "empty",
            "timeout",
            "error"
          ],
          "title": "Sparse Status",
          "type": "string"
        },
        "rerank_status": {
          "default": "skipped",
          "enum": [
            "skipped",
            "hit",
            "empty",
            "timeout",
            "error"
          ],
          "title": "Rerank Status",
          "type": "string"
        },
        "dense_hit_count": {
          "default": 0,
          "minimum": 0,
          "title": "Dense Hit Count",
          "type": "integer"
        },
        "sparse_hit_count": {
          "default": 0,
          "minimum": 0,
          "title": "Sparse Hit Count",
          "type": "integer"
        },
        "rerank_input_count": {
          "default": 0,
          "minimum": 0,
          "title": "Rerank Input Count",
          "type": "integer"
        },
        "dense_degraded": {
          "default": false,
          "title": "Dense Degraded",
          "type": "boolean"
        },
        "sparse_degraded": {
          "default": false,
          "title": "Sparse Degraded",
          "type": "boolean"
        },
        "dense_timeout_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Dense Timeout Ms",
          "type": "integer"
        },
        "sparse_timeout_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Sparse Timeout Ms",
          "type": "integer"
        },
        "rerank_timeout_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Rerank Timeout Ms",
          "type": "integer"
        },
        "index_versions": {
          "items": {
            "type": "string"
          },
          "title": "Index Versions",
          "type": "array"
        },
        "model_names": {
          "items": {
            "type": "string"
          },
          "title": "Model Names",
          "type": "array"
        },
        "chunk_versions": {
          "items": {
            "type": "string"
          },
          "title": "Chunk Versions",
          "type": "array"
        },
        "index_generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Generated At"
        },
        "context_token_count": {
          "default": 0,
          "minimum": 0,
          "title": "Context Token Count",
          "type": "integer"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/CandidateTrace"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "original_query",
        "normalized_query",
        "retrieval_version",
        "retrieval_variant",
        "indexed_chunk_count",
        "dense_latency_ms",
        "sparse_latency_ms",
        "fusion_latency_ms",
        "rerank_latency_ms",
        "total_latency_ms",
        "candidates"
      ],
      "title": "RetrievalTrace",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "trace": {
      "$ref": "#/$defs/RetrievalTrace"
    }
  },
  "required": [
    "request_id",
    "evidence",
    "trace"
  ],
  "title": "RetrievalResponse",
  "type": "object"
}
